\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Figura S1: Nivel 1 ($\pm 10\%$ --- Rango Fisiológico Estricto)}{8}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Espacio posterior de 9 dimensiones bajo incertidumbre estrecha ($\pm 10\%$).} Nótese cómo los 5 parámetros secundarios exhiben distribuciones marginales planas (diagonal) y nubes bivariadas ortogonales isotrópicas (fuera de la diagonal), confirmando empíricamente su condición formal de parámetros \textit  {sloppy}.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:supp_s1}{{4}{9}{\textbf {Espacio posterior de 9 dimensiones bajo incertidumbre estrecha ($\pm 10\%$).} Nótese cómo los 5 parámetros secundarios exhiben distribuciones marginales planas (diagonal) y nubes bivariadas ortogonales isotrópicas (fuera de la diagonal), confirmando empíricamente su condición formal de parámetros \textit {sloppy}}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Figura S2: Nivel 2 ($\pm 25\%$ --- Variabilidad Interindividual Moderada)}{9}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Espacio posterior de 9 dimensiones bajo variabilidad moderada ($\pm 25\%$).} Se confirma la robustez estructural y la invarianza del centroide en los 5 parámetros secundarios, así como la contracción persistente de $\beta _{BRCA1}$ y $\delta _{\text  {BRCA+}}$.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:supp_s2}{{5}{10}{\textbf {Espacio posterior de 9 dimensiones bajo variabilidad moderada ($\pm 25\%$).} Se confirma la robustez estructural y la invarianza del centroide en los 5 parámetros secundarios, así como la contracción persistente de $\beta _{BRCA1}$ y $\delta _{\text {BRCA+}}$}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Figura S3: Nivel 3 ($\pm 50\%$ --- Prueba de Estrés de Frontera)}{10}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Espacio posterior de 9 dimensiones bajo relajación extrema ($\pm 50\%$).} Se hace visible la aparición de correlaciones espurias de compensación entre $\mu _{TP53}$ y $\theta _{D\text  {\_inmune}}$, demostrando gráficamente por qué una calibración ciega de 9 parámetros simultáneos introduce artefactos numéricos indeseados.}}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:supp_s3}{{6}{11}{\textbf {Espacio posterior de 9 dimensiones bajo relajación extrema ($\pm 50\%$).} Se hace visible la aparición de correlaciones espurias de compensación entre $\mu _{TP53}$ y $\theta _{D\text {\_inmune}}$, demostrando gráficamente por qué una calibración ciega de 9 parámetros simultáneos introduce artefactos numéricos indeseados}{figure.caption.11}{}}
